# FRONTEND_INGEST_URL=http://localhost:3000/api/monitor/ingest
# FRONTEND_INGEST_URL=https://full-falldetect-git-main-kielobashs-projects.vercel.app/api/monitor/ingest

FRONTEND_BASE_URL=http://192.168.1.10:3000
# Must equal MONITOR_INGEST_SECRET in frontend/.env on laptop 1
MONITOR_INGEST_SECRET=some-long-random-shared-secret
# Must equal STREAM_TOKEN_SECRET in frontend/.env on laptop 1 (32+ characters)
STREAM_TOKEN_SECRET=some-long-random-shared-secret-2

# ── This laptop ──
NODE_KEY=floor2-laptop
NODE_NAME=Floor 2 camera laptop

# ── Video server ──
STREAM_PORT=8002
# Leave empty: this laptop's Wi-Fi IP is detected and sent to laptop 1 automatically
PUBLIC_STREAM_URL=
STREAM_FPS=10
STREAM_MAX_WIDTH=960
STREAM_JPEG_QUALITY=70

# ── Model + cameras ──
# Leave empty to use backend/model/best_v2.pt
WEIGHTS_PATH=
# OpenCV camera index : Sensor ID (must match the Sensor ID in Admin → Rooms)
CAMERA_ID_MAP=0:CAM-201,1:CAM-202

# ── Supabase Storage (screenshots) ──
SUPABASE_URL=https://ivseduhjgqmdoekxaesc.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Upload-only via the bucket policy.
SUPABASE_UPLOAD_KEY=sb_publishable_vwmyXSFOaNtFaS-jU59cjQ_AhLeV1Ar
SUPABASE_BUCKET=fall-screenshots