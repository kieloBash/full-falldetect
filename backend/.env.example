# location: backend/.env.example → copy to backend/.env on LAPTOP 2 (camera laptop)
# Never commit or zip the real .env.

# ── Laptop 1 (web app) ── use laptop 1's fixed Wi-Fi IP
FRONTEND_BASE_URL=http://192.168.1.10:3000
# Must equal MONITOR_INGEST_SECRET in frontend/.env on laptop 1
MONITOR_INGEST_SECRET=change-me
# Must equal STREAM_TOKEN_SECRET in frontend/.env on laptop 1 (32+ characters)
STREAM_TOKEN_SECRET=change-me-to-a-long-random-string-32-chars-min

# ── This laptop ──
NODE_KEY=floor2-laptop
NODE_NAME=Floor 2 camera laptop

# ── Supabase Storage (screenshots) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Upload-only via the bucket policy.
SUPABASE_UPLOAD_KEY=sb_publishable_...
SUPABASE_BUCKET=fall-screenshots

# ── Video server ──
STREAM_PORT=8002
# Leave empty: this laptop's Wi-Fi IP is detected and sent to laptop 1 automatically
PUBLIC_STREAM_URL=
STREAM_FPS=10
STREAM_MAX_WIDTH=960
STREAM_JPEG_QUALITY=70

# ── Model + cameras ──
# Leave empty to use backend/model/best_v2.pt
WEIGHTS_PATH=
# Cameras are read from the shared config/cameras.json (camera index → Sensor ID → room → patient).
# Laptop 1 seeds the same file into the database with `npm run seed:cameras`.
# Different location? Set the full path:
# CAMERA_CONFIG_FILE=C:\FallDetect\config\cameras.json
# Quick override without the file (not linked to patients): 0:CAM-201,1:CAM-202
# CAMERA_ID_MAP=
